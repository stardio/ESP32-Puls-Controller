menu "TFW test firmware (D-025, G3 pre-test only)"

    config TFW_AX1_PLS_GPIO
        int "Axis 1 pulse GPIO (also PCNT loop-back input)"
        default 25
    config TFW_AX1_DIR_GPIO
        int "Axis 1 direction GPIO"
        default 32
    config TFW_PULSE_OE_GPIO
        int "Pulse output enable GPIO, shared by both axes (baseline v0.4 F-03..F-05: GPIO33 -> TLP2361 -> AM26C31 /G)"
        default 33
        help
          Driven LOW at boot (output forbidden) and raised once after the pulse axes are created.
          It is NOT touched by STOP: STOP only forces the pulse output of its own axis LOW.
    config TFW_PULSE_OE_ACTIVE_LOW
        bool "Pulse output enable is active LOW (off = HIGH allows output, baseline v0.4 F-03)"
        default n
    config TFW_AX2_PLS_GPIO
        int "Axis 2 pulse GPIO (baseline v0.4 F-01: 20; -1 = axis 2 not created)"
        default 20
    config TFW_AX2_DIR_GPIO
        int "Axis 2 direction GPIO (baseline v0.4 F-02: 21; -1 = axis 2 not created)"
        default 21
    config TFW_AXIS_COUNT
        int "Number of axes to bring up (1 or 2)"
        range 1 2
        default 2
    config TFW_ESTOP_GPIO
        int "Axis 1 STOP input GPIO (DI2, J15; baseline v0.4 F-06: GPIO19)"
        default 19
        help
          T-07 stimulus (baseline v0.4 F-12): feed the J15 DI2 terminal from a 24 V switch wired as an NC contact
          (closed in normal operation); opening it is the STOP. Check the boot log: with the switch closed the input
          must read "inactive". If it reads ACTIVE, the TLP293 polarity is the other way round: flip TFW_ESTOP_ACTIVE_LOW.
          Axis 2: the same with the DI4 terminal (GPIO17).
    config TFW_AX2_IO_PRESENT
        bool "Carrier axis 2 DI parts present (DI3 START, DI4 STOP wired) [D-068]"
        default n
        help
          Off (default): axis 2 STOP (GPIO17) and START (GPIO18) are ignored (not configured, never block); axis 2 pulses
          are driven only by Modbus/host commands. This keeps a floating NC-type input from holding axis 2 "always
          stopped" when only the 1-axis carrier is available and GPIO20/21 are measured at the board header.
          Turn on only when the 2-axis carrier (U16, J14, DI3/DI4) is wired.
    config TFW_ESTOP2_GPIO
        int "Axis 2 STOP input GPIO (DI4; baseline v0.4 F-06: GPIO17; -1 = none)"
        default 8
    config TFW_ESTOP_ACTIVE_LOW
        bool "STOP input active LOW. Off (default, baseline v0.4 F-07) = NC contact, active HIGH"
        default n
    config TFW_START_GPIO
        int "Axis 1 START input GPIO (DI1, edge; baseline v0.4 sec.7: GPIO54; -1 = none)"
        default 54
    config TFW_START2_GPIO
        int "Axis 2 START input GPIO (DI3, edge; baseline v0.4 sec.7: GPIO18; -1 = none)"
        default 7
    config TFW_START_ACTIVE_LOW
        bool "START input active LOW (contact closed -> TLP293 on -> GPIO LOW) [recommended default, unverified on the board]"
        default y
    config TFW_START_DEBOUNCE_MS
        int "START input stable time before an edge is accepted [recommended 5 ms]"
        range 1 100
        default 5
    config TFW_DEBUG_GPIO
        int "Debug GPIO toggled in the watch-point ISR (-1 = off)"
        default -1
    config TFW_DEBUG_GPIO_ESTOP
        int "Debug GPIO toggled in the e-stop ISR (-1 = off)"
        default -1
    config TFW_PROBE_GPIO
        int "GPIO used only by the boot-time resource probe (-1 = probe skipped; must not be used by anything else)"
        default -1
    config TFW_IRQ_PRIO_ESTOP
        int "Interrupt level of the e-stop GPIO ISR (0 = default; highest of the three, M-03)"
        range 0 3
        default 3
    config TFW_IRQ_PRIO_PCNT
        int "Interrupt level of the PCNT watch-point ISR (0 = driver default)"
        range 0 3
        default 2
    config TFW_IRQ_PRIO_GPT
        int "Interrupt level of the GPTimer update ISR (0 = driver default)"
        range 0 3
        default 1
    config TFW_UPD_MODE_HWTIMER
        bool "Speed update from GPTimer ISR (off = 10 ms task, reproduces servo1axis)"
        default y
    config TFW_LEGACY_NVS_ON_WRITE
        bool "Save legacy HR values to NVS on every Modbus write (reproduces servo1axis risk 3; T-06 comparison only)"
        default n
    config TFW_IP_A
        int "IP A"
        default 192
    config TFW_IP_B
        int "IP B"
        default 168
    config TFW_IP_C
        int "IP C"
        default 0
    config TFW_IP_D
        int "IP D"
        default 220
    config TFW_PORT
        int "Modbus TCP port"
        default 502
    config TFW_UNIT_ID
        int "Modbus unit id"
        default 1
    config TFW_MAX_CLIENTS
        int "Max simultaneous Modbus TCP clients [assumed 4]"
        default 4
        help
          T-05 uses 4 load clients + the control connection (+ the HMI): build with 8 for T-05,
          keep 4 for the "5th connection is refused" check.
    config TFW_ETM_EXPERIMENT
        bool "Compile the PCNT->MCPWM ETM experiment (not implemented, reports 'not tested')"
        default n
endmenu
