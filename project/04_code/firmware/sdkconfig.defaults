# ESP32-P4 pulse servo controller (1/2 axis). Build: idf.py set-target esp32p4 && idf.py build   (ESP-IDF 5.5.3)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# 1 ms tasks (STOP/START watch task) need a 1 kHz tick
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# Ethernet: on-board IP101 over RMII (as servo1axis). The optional W5500 is not used.
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y

# ISR / flash safety: pulse ISRs and driver control functions stay in IRAM so that NVS writes (flash cache off) cannot
# stop them (test-fw review M-01, risk 2). Option names per ESP-IDF 5.x; verify with: grep -E "IRAM" sdkconfig
CONFIG_PCNT_ISR_IRAM_SAFE=y
CONFIG_PCNT_CTRL_FUNC_IN_IRAM=y
CONFIG_MCPWM_ISR_IRAM_SAFE=y
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y
CONFIG_MCPWM_ISR_HANDLER_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Watchdogs: interrupt WDT on both cores, task WDT reconfigured by the firmware (fw_hal_wdt_init), panic = reset.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_INT_WDT_CHECK_CPU1=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_BOOTLOADER_WDT_ENABLE=y

CONFIG_LWIP_MAX_SOCKETS=10
