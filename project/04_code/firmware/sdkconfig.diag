# DIAGNOSTIC ONLY (G2 condition C1, I-049): task stack high-water report on the console. Not for products.
# Build: idf.py -B build_diag -D SDKCONFIG=build_diag/sdkconfig
#        -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.model_2axis_tcp;sdkconfig.bench;sdkconfig.diag" set-target esp32p4 build
CONFIG_FW_DIAG_STACK_REPORT=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
